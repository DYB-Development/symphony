{
  "SessionStart": [
    { "hooks": [ { "type": "command", "command": "__SYMPHONY_BIN__/writing-style-hook.sh" } ] }
  ],
  "SubagentStart": [
    { "matcher": "*", "hooks": [ { "type": "command", "command": "__SYMPHONY_BIN__/writing-style-hook.sh" } ] }
  ],
  "PostToolUse": [
    { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "__SYMPHONY_BIN__/decision-gate.sh arm" } ] }
  ],
  "PreToolUse": [
    { "matcher": "Bash", "hooks": [ { "type": "command", "command": "__SYMPHONY_BIN__/decision-gate.sh check" } ] }
  ]
}
