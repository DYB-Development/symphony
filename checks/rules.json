    {
      "file": "agents/review-scribe.md",
      "contains": "Marking each check is required, never skipped, and is the first thing you do for it."
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "Marking each finding is required, never skipped, and is the first thing you do for it."
