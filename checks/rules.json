      "file": "rules/draft-reading.md",
      "contains": "mktemp -d"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": ".review-<pr>.claims.json"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "a side"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "Every Findings bullet that reports a finding"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "~/.claude/bin/capture-evidence.sh"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "A finding whose pointer cannot be resolved is cut from the draft."
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "Cut for an unresolved pointer:"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "Every inline comment has a claim whose pointer is that comment's own path, line and side."
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "~/.claude/bin/review-draft.sh --check-lines"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "~/.claude/bin/judge-claims.sh"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "~/.claude/bin/read-draft.sh"
    },
    {
      "file": "agents/issue-scribe.md",
      "contains": "~/.claude/bin/read-draft.sh"
    },
    {
      "file": "agents/pr-scribe.md",
      "contains": "~/.claude/bin/read-draft.sh"
    },
    {
      "file": "agents/plan-scribe.md",
      "contains": "~/.claude/bin/read-draft.sh"
    },
    {
      "file": "agents/audit-scribe.md",
      "contains": "~/.claude/bin/read-draft.sh"
    },
    {
      "file": "rules/draft-reading.md",
      "absent": "Flag: none"
    },
    {
      "file": "rules/draft-reading.md",
      "contains": "only the sentences you rewrote"
    },
    {
      "file": "rules/review-checks.md",
      "contains": "a behaviour no test reaches is a finding on its own"
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "- Any finding the code is not actually wrong without, apart from the two the bar in `pr-review.md` lets past."
    },
    {
      "file": "agents/review-scribe.md",
      "contains": "- **Never run the code.**"
    },
    {
      "file": "rules/pr-body.md",
      "contains": "~/.claude/bin/pr-wait.sh <owner/repo> <pr-number>"
    }
  ]
